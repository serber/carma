[Unit]
Description=carma - Raspberry Pi ANPR box
After=network.target

[Service]
Type=simple
User=carma
WorkingDirectory=/opt/carma
ExecStart=/opt/carma/.venv/bin/carma --config /opt/carma/config.yaml
Restart=on-failure
RestartSec=5

# journald captures stdout/stderr; view with: journalctl -u carma -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
